pragma solidity ^0.8.25;

import { Test, console2 } from "forge-std/Test.sol";

/// @dev Fork test that reproduces and validates the fillContractOrderArgs encoding.
///
/// Run: forge test --match-test test_fusionFill -vvvv
///
/// Captured order: WETH → USDT, ERC-1271 maker (0x0d7cae...)
///
/// Root causes found via source analysis of TakerTraitsLib._parseArgs:
///   1. args layout was [extension][resolver][interaction]
///      → must be [resolver 20B][extension][interaction]  (LOP strips target FIRST)
///   2. takerTraits bits 250 (ARGS_HAS_EXTENSION) don't exist
///      → extension length lives in bits 224-247 (24-bit field)
///      → interaction length lives in bits 200-223 (24-bit field)
contract FusionFillTest is Test {
    address constant LOP              = 0x111111125421cA6dc452d289314280a0f8842A65;
    address constant VIRTUAL_RESOLVER = 0x00000000000000000000b09498030ae3416b66Dc;

    function setUp() public {
        vm.createSelectFork(vm.rpcUrl("mainnet"));
    }

    /// @dev Baseline: the calldata from the OLD (broken) Rust encoding.
    ///      Expected to revert with MissingOrderExtension (0xb2d25e49).
    function test_fusionFill_oldEncoding_reverts() public {
        vm.prank(VIRTUAL_RESOLVER);
        (, bytes memory reason) = LOP.call(_oldCalldata());
        assertEq(bytes4(reason), bytes4(0xb2d25e49), "expected MissingOrderExtension");
    }

    /// @dev Calldata with CORRECT encoding (post-fix) that produces BadSignature(0x5cd5d233).
    ///      EOA-signed order: USDC → synthetic stock token, maker 0x7bd9b3e7...
    ///      Captured at block 25222192.
    /// @dev Reproduces BadSignature: EOA maker + fillContractOrderArgs = isValidSignature on
    ///      no-code address returns empty → BadSignature (0x5cd5d233).
    function test_fusionFill_badSignature_reproduced() public {
        bytes memory cd = _badSigCalldata();
        uint256 inner_len;
        assembly { inner_len := mload(add(add(cd, 0x20), 36)) }
        bytes memory inner = new bytes(inner_len);
        for (uint256 i = 0; i < inner_len; i++) inner[i] = cd[68 + i];

        vm.prank(VIRTUAL_RESOLVER);
        (, bytes memory reason) = LOP.call(inner);
        assertEq(bytes4(reason), bytes4(0x5cd5d233), "expected BadSignature from EOA maker");
    }

    /// @dev Fix: fillOrderArgs (ecrecover) for 65-byte ECDSA sigs — should NOT get BadSignature.
    ///      Passes empty args to isolate the signature validation path.
    function test_fusionFill_eoa_fillOrderArgs_sigPasses() public {
        bytes32 r = 0xa2b06e2ef5996a275685ec2bd53ff9a031db48b996a9d889966d8b85d68a8f42;
        bytes32 s = 0x20bd69534ac6eb48d5ec0332216d897159948f39dcd29c3e5e94dac4875661a1;

        bytes memory fillCalldata = abi.encodeWithSelector(
            bytes4(0xf497df75), // fillOrderArgs
            uint256(302357391081649567103608031955936703713211444944073250620149527618004730605),
            uint256(707060798297091409992591362844657765328574809602),
            uint256(328785468947783864411323925846935372110738122638),
            uint256(917551056842671309452305380979543736893630245704),
            uint256(127014952013497652268381707256852740075590616915),
            uint256(97216085),
            uint256(250433171746873522555),
            uint256(62419173104490761595518734106350460423628846628855791358767729315888928653312),
            r, s,
            uint256(97216085),
            uint256(3618514354484639709081304961269037707084028775624804079775705398452656126331),
            bytes("") // empty args for now — just testing sig path
        );

        vm.prank(VIRTUAL_RESOLVER);
        (, bytes memory reason) = LOP.call(fillCalldata);
        bytes4 sel = bytes4(reason);
        console2.log("fillOrderArgs error:", vm.toString(sel));
        // BadSignature = 0x5cd5d233 — any other error means sig validation passed
        assertTrue(sel != bytes4(0x5cd5d233), "fillOrderArgs should not produce BadSignature");
    }

    // ── Helpers ────────────────────────────────────────────────────────────────

    /// @dev Calldata captured from the smoke test BEFORE the fix.
    ///      Selector 0x56a75868 (fillContractOrderArgs), but:
    ///        - args layout: [extension 459B][resolver 20B][interaction 768B]  ← WRONG
    ///        - takerTraits bits 224-247 (extensionLength) = 0                ← WRONG
    function _badSigCalldata() internal pure returns (bytes memory) {
        return hex"";
    }

    function _oldCalldata() internal pure returns (bytes memory) {
        return hex"";
    }
}
