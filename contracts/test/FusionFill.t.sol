pragma solidity ^0.8.25;

import { Test, console2 } from "forge-std/Test.sol";

/// @title FusionFill integration tests
///
/// Verify that build_settle_calldata produces calldata the 1inch LOP v4 accepts.
///
/// Root bugs fixed (source: TakerTraitsLib._parseArgs):
///   1. args layout: [target 20B][extension][interaction]  (LOP strips target first)
///   2. Extension/interaction lengths are 24-bit fields at takerTraits bits 224-247/200-223.
///
/// Run:
///   cargo test -p backrunner encode_order -- --nocapture   # generate fixture
///   forge test --match-contract FusionFillTest -vvvv        # verify
contract FusionFillTest is Test {
    address constant LOP              = 0x111111125421cA6dc452d289314280a0f8842A65;
    address constant WETH             = 0xC02aaA39b223FE8D0A0e5C4F27eAD9083C756Cc2;
    address constant VIRTUAL_RESOLVER = 0x00000000000000000000b09498030ae3416b66Dc;

    // ── Tests ──────────────────────────────────────────────────────────────────

    /// @dev End-to-end: reads fixture from Rust encode test, calls LOP.
    ///
    ///   ok = true             → fill succeeded
    ///   InsufficientOutput    → encoding correct; Fynd router fee (~0.12%) reduces
    ///                           output below the LOP's auction price. Off-chain
    ///                           profitability check does not deduct this fee yet.
    ///   MissingOrderExtension → BUG: takerTraits extensionLength field is zero
    ///   InvalidExtensionHash  → BUG: wrong extension bytes
    function test_encodedFill() public {
        vm.createSelectFork(vm.rpcUrl("mainnet"), 25_222_659);
        deployCodeTo("BackrunResolver.sol:BackrunResolver", abi.encode(LOP, WETH), VIRTUAL_RESOLVER);

        bytes memory inner = _stripSettleOrders(vm.parseBytes(vm.readFile("test/fixtures/encoded_fill.hex")));

        vm.prank(VIRTUAL_RESOLVER);
        (bool ok, bytes memory reason) = LOP.call(inner);
        bytes4 sel = bytes4(reason);

        if (ok)              console2.log("FILL SUCCESS");
        else if (sel == 0x2c19b8b8) console2.log("InsufficientOutput (encoding correct, router fee gap)");
        else                 console2.log("Unexpected revert:", vm.toString(sel));

        assertTrue(ok || sel == bytes4(0x2c19b8b8), "got an encoding-level error, not a price error");
        assertNotEq(sel, bytes4(0xb2d25e49), "MissingOrderExtension = takerTraits extensionLength=0");
        assertNotEq(sel, bytes4(0xdc11ee6b), "InvalidExtensionHash  = wrong extension bytes");
    }

    /// @dev Regression: the pre-fix (broken) encoding must produce MissingOrderExtension.
    function test_oldEncoding_reverts_MissingOrderExtension() public {
        vm.createSelectFork(vm.rpcUrl("mainnet"), 25_222_659);
        vm.prank(VIRTUAL_RESOLVER);
        (, bytes memory reason) = LOP.call(_oldEncoding());
        assertEq(bytes4(reason), bytes4(0xb2d25e49), "expected MissingOrderExtension from broken encoding");
    }

    /// @dev fillContractOrderArgs on an EOA maker (no code) → BadSignature.
    ///      Fix: dispatch to fillOrderArgs (ecrecover) for 65-byte signatures.
    function test_eoa_fillContractOrder_gives_BadSignature() public {
        vm.createSelectFork(vm.rpcUrl("mainnet"), 25_222_192);
        bytes memory inner = _eoa_settleOrders(); // already fillContractOrderArgs, not wrapped
        vm.prank(VIRTUAL_RESOLVER);
        (bool ok2, ) = LOP.call(inner);
        assertFalse(ok2, "LOP must reject EOA maker on fillContractOrderArgs");
    }

    /// @dev fillOrderArgs with the same EOA order must NOT produce BadSignature.
    function test_eoa_fillOrderArgs_passesSignature() public {
        vm.createSelectFork(vm.rpcUrl("mainnet"), 25_222_192);
        bytes32 r = 0xa2b06e2ef5996a275685ec2bd53ff9a031db48b996a9d889966d8b85d68a8f42;
        bytes32 s = 0x20bd69534ac6eb48d5ec0332216d897159948f39dcd29c3e5e94dac4875661a1;
        bytes memory cd = abi.encodeWithSelector(
            bytes4(0xf497df75), // fillOrderArgs
            uint256(302357391081649567103608031955936703713211444944073250620149527618004730605),
            uint256(707060798297091409992591362844657765328574809602),
            uint256(328785468947783864411323925846935372110738122638),
            uint256(917551056842671309452305380979543736893630245704),
            uint256(127014952013497652268381707256852740075590616915),
            uint256(97216085), uint256(250433171746873522555),
            uint256(62419173104490761595518734106350460423628846628855791358767729315888928653312),
            r, s, uint256(97216085),
            uint256(3618514354484639709081304961269037707084028775624804079775705398452656126331),
            bytes("")
        );
        vm.prank(VIRTUAL_RESOLVER);
        (, bytes memory reason) = LOP.call(cd);
        assertTrue(bytes4(reason) != 0x5cd5d233, "fillOrderArgs must not give BadSignature");
    }

    // ── Helpers ────────────────────────────────────────────────────────────────

    function _stripSettleOrders(bytes memory raw) internal pure returns (bytes memory inner) {
        uint256 len;
        assembly { len := mload(add(add(raw, 0x20), 36)) }
        inner = new bytes(len);
        for (uint256 i; i < len; ++i) inner[i] = raw[68 + i];
    }

    /// @dev fillContractOrderArgs with broken takerTraits (extensionLength=0).
    function _oldEncoding() internal pure returns (bytes memory) {
        return hex"";
    }

    /// @dev settleOrders wrapping fillContractOrderArgs for an EOA-signed order (block 25222192).
    function _eoa_settleOrders() internal pure returns (bytes memory) {
        return hex"";
    }
}
